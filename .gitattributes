* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.ipynb text eol=lf
*.csv text eol=lf
*.joblib binary
*.png binary
*.pdf binary
# Los manifiestos verifican SHA-256 de bytes exactos, incluidos saltos de línea.
# CR forma parte de CRLF, no de espacios sobrantes; se mantienen los demás chequeos.
/models/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/reports/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
